# Copy to .env.local for local development. Never commit real secrets.

# Public site address (used for links, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity content dashboard (the project ID is public)
NEXT_PUBLIC_SANITY_PROJECT_ID=8ii09o5j
NEXT_PUBLIC_SANITY_DATASET=production

# Optional read-only (Viewer) token. The dataset is private, so the site needs
# this or SANITY_API_WRITE_TOKEN to read content.
SANITY_API_READ_TOKEN=

# Secret shared with the Sanity webhook that refreshes the site on publish
SANITY_REVALIDATE_SECRET=

# Editor token (sanity.io/manage → API → Tokens). Needed to mark paintings
# sold, save orders and commission requests, and run `npm run seed`.
SANITY_API_WRITE_TOKEN=

# Set to "true" to use built-in sample paintings instead of Sanity
USE_SAMPLE_CONTENT=

# --- Payments (Stripe, test mode during development) ---
# dashboard.stripe.com → Developers → API keys (use the sk_test_ key)
STRIPE_SECRET_KEY=
# From the webhook endpoint (or `stripe listen` when testing locally)
STRIPE_WEBHOOK_SECRET=
# "true" to charge sales tax with Stripe Tax (must be set up in Stripe first)
STRIPE_AUTOMATIC_TAX=

# --- Email (Resend) ---
RESEND_API_KEY=
# Until a domain is verified in Resend, keep the default onboarding@resend.dev sender
EMAIL_FROM=Melissa's Art <onboarding@resend.dev>
# Private inbox for new orders and form messages (defaults to the public email)
NOTIFICATION_EMAIL=
